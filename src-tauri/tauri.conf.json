{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rml-launcher",
  "version": "0.1.0",
  "identifier": "com.revolution.rml-launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RML Launcher",
        "width": 880,
        "height": 540,
        "minWidth": 880,
        "minHeight": 540,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
